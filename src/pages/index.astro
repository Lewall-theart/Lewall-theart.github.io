---
import Base from '../layouts/Base.astro'
import { publishedWriteups } from '../data/writeups'
import { siteConfig } from '../data/site.config'
import TechHeroCanvas from '../components/TechHeroCanvas.vue'
import AnimeHeroText from '../components/AnimeHeroText.vue'

const all = publishedWriteups
const sorted = [...all].sort((a, b) => b.date.getTime() - a.date.getTime())
const recent = sorted.slice(0, 6)
const allTags = [...new Set(all.flatMap((w) => w.tags))].slice(0, 14)
const categories = [...new Set(all.map((w) => w.category))]
---

<Base title={siteConfig.home.pageTitle}>
  <div class="max-w-5xl mx-auto">
    <!-- Hero Section with Three.js & Anime.js -->
    <section class="mb-14 grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-8 items-center border-b border-neutral-200 dark:border-neutral-800 pb-12">
      <div>
        <AnimeHeroText
          client:load
          badge={siteConfig.home.badgeText}
          title={siteConfig.home.title}
          subtitle={siteConfig.home.subtitle}
        />

        <!-- Status & Stats Pills -->
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-100/80 dark:bg-neutral-900/60 px-3.5 py-1 text-xs font-mono text-neutral-600 dark:text-neutral-300">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Status: Active &amp; Up to date</span>
          </div>

          <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-100/80 dark:bg-neutral-900/60 px-3.5 py-1 text-xs font-mono text-neutral-600 dark:text-neutral-300">
            <span class="text-neutral-400 font-semibold">{all.length}</span>
            <span>Writeups</span>
          </div>

          <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-100/80 dark:bg-neutral-900/60 px-3.5 py-1 text-xs font-mono text-neutral-600 dark:text-neutral-300">
            <span class="text-neutral-400 font-semibold">{categories.length}</span>
            <span>Categories</span>
          </div>
        </div>

        <!-- Quick CTF Actions -->
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/writeups"
            class="px-5 py-2.5 rounded-xl bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 text-xs font-mono tracking-wider uppercase font-semibold hover:opacity-90 transition-opacity no-underline"
          >
            Explore Writeups →
          </a>
          <a
            href="/achievement"
            class="px-5 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 text-neutral-800 dark:text-neutral-200 text-xs font-mono tracking-wider uppercase hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors no-underline"
          >
            Achievements
          </a>
        </div>
      </div>

      <!-- Three.js 3D Interactive Cyber Core -->
      <div class="hidden lg:flex items-center justify-center">
        <TechHeroCanvas client:load />
      </div>
    </section>

    <!-- Popular Tags Bar -->
    <section class="mb-12">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
          <span class="h-px w-5 bg-neutral-400 dark:bg-neutral-600"></span>
          <span>Topics &amp; Tags</span>
        </div>
        <a href="/tags" class="text-xs font-mono text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors">
          All tags ({allTags.length}) →
        </a>
      </div>
      <div class="flex flex-wrap gap-2">
        {allTags.map((t) => (
          <a href={`/tags/${encodeURIComponent(t.toLowerCase())}`} class="tag-pill">
            {t}
          </a>
        ))}
      </div>
    </section>

    <!-- Recent Writeups (Tech-Blog Card Layout) -->
    <section class="space-y-8">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
          <span class="h-px w-5 bg-neutral-400 dark:bg-neutral-600"></span>
          <span>Latest Articles</span>
        </div>
        <a href="/writeups" class="text-xs font-mono text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors">
          View all ({all.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6">
        {recent.map((w, index) => {
          const displayDate = w.date.toLocaleDateString(
            siteConfig.formatting.dateLocale,
            siteConfig.formatting.dateOptions
          )

          return (
            <article
              class="group relative overflow-hidden rounded-2xl surface-card p-6 sm:p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg rise-in"
              style={`animation-delay: ${100 + index * 70}ms;`}
            >
              <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center rounded-full border border-neutral-900/80 bg-neutral-900 px-3 py-1 text-[10px] font-mono uppercase tracking-widest text-neutral-100 dark:border-neutral-100/80 dark:bg-neutral-100 dark:text-neutral-900">
                    {w.category}
                  </span>
                  <div class={`diff diff-${w.difficulty}`}>
                    <div class="diff-dot"></div><div class="diff-dot"></div><div class="diff-dot"></div>
                  </div>
                  <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-400">{w.difficulty}</span>
                </div>
                <time class="text-xs font-mono text-neutral-500 dark:text-neutral-400">
                  {displayDate}
                </time>
              </div>

              <a href={`/writeups/${w.slug}`} class="block no-underline">
                <h2 class="text-xl sm:text-2xl font-semibold mb-3 text-neutral-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
                  {w.title}
                </h2>
                <p class="text-neutral-600 dark:text-neutral-300 text-sm leading-relaxed mb-4 line-clamp-2">
                  {w.description}
                </p>
              </a>

              <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-neutral-100 dark:border-neutral-800/80">
                <div class="flex flex-wrap gap-1.5">
                  {w.tags.slice(0, 3).map((t) => (
                    <span class="text-[10px] font-mono text-neutral-400 px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-800">
                      #{t}
                    </span>
                  ))}
                </div>

                <a
                  href={`/writeups/${w.slug}`}
                  class="text-neutral-800 dark:text-neutral-200 font-mono text-xs uppercase tracking-widest hover:underline decoration-neutral-400 underline-offset-4 flex items-center gap-1.5"
                >
                  <span>{siteConfig.home.readMoreLabel}</span>
                </a>
              </div>
            </article>
          )
        })}
      </div>
    </section>
  </div>
</Base>
