---
// src/pages/index.astro
import Base from '../layouts/Base.astro'
import { getCollection } from 'astro:content'
import HeroTerminal from '../components/HeroTerminal.vue'
import CountUp from '../components/CountUp.vue'
import CategoryBars from '../components/CategoryBars.vue'

const allWriteups = await getCollection('writeups')
const recent = allWriteups
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 5)

const featured = allWriteups.find(w => w.data.featured) ?? recent[0]
---

<Base title="Home">

  <!-- ── HERO ── -->
  <section class="relative pt-40 pb-25 overflow-hidden">
    <!-- BG glow -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-[20%] left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-[radial-gradient(ellipse_at_center,rgba(0,212,255,0.06)_0%,transparent_70%)]"></div>
    </div>
    <!-- Corner brackets -->
    <div class="absolute top-[80px] left-10 w-20 h-20 border-t border-l border-cyan/15"></div>
    <div class="absolute bottom-10 right-10 w-20 h-20 border-b border-r border-cyan/15"></div>

    <div class="container relative z-1">
      <div class="flex items-center gap-3 mb-7 animate-[fadeUp_0.6s_ease_both]">
        <div class="w-2 h-2 rounded-full bg-green" style="animation: heartbeat 2s infinite"></div>
        <span class="font-mono text-[11px] tracking-[3px] uppercase text-green">CTF Writeups &amp; Notes</span>
      </div>

      <h1 class="font-display font-800 leading-[0.95] tracking-[-4px] text-bright mb-7 animate-[fadeUp_0.6s_0.1s_ease_both] opacity-0" style="font-size: clamp(52px,9vw,100px); animation-fill-mode: forwards">
        BREAK.<br>
        <span class="text-cyan">ANALYZE.</span><br>
        <span class="text-mute font-400 text-[0.55em] tracking-[-2px]">Document.</span>
      </h1>

      <p class="max-w-[500px] text-[15px] text-dim leading-relaxed mb-10 animate-[fadeUp_0.6s_0.2s_ease_both] opacity-0" style="animation-fill-mode: forwards">
        Tài liệu hóa hành trình giải các thử thách CTF — từ RSA bị gãy, SQL injection lách luật,
        đến reverse engineering không có mercy.
      </p>

      <div class="flex gap-4 flex-wrap animate-[fadeUp_0.6s_0.3s_ease_both] opacity-0" style="animation-fill-mode: forwards">
        <a href="/writeups" class="btn-primary btn">
          <span>⬡</span> Xem Writeups
        </a>
        <a href="/about" class="btn-ghost btn">
          <span>◎</span> About
        </a>
      </div>
    </div>
  </section>

  <div class="container relative z-1">

    <!-- ── STATS ── -->
    <div class="grid grid-cols-2 md:grid-cols-4 border border-border mb-20 animate-[fadeUp_0.6s_0.4s_ease_both] opacity-0" style="animation-fill-mode: forwards">
      <CountUp client:visible target={allWriteups.length} label="Writeups" />
      <CountUp client:visible target={6} label="Categories" />
      <CountUp client:visible target={18} label="CTF Events" />
      <CountUp client:visible target={7} label="1st Bloods" />
    </div>

    <!-- ── FEATURED ── -->
    <div class="section-label mb-9">
      <span class="section-label-text">// featured writeup</span>
      <div class="section-label-line"></div>
    </div>

    {featured && (
      <div class="grid grid-cols-1 md:grid-cols-[1fr_300px] border border-border mb-20 relative overflow-hidden group">
        <!-- Top accent line -->
        <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-cyan to-green z-10"></div>

        <!-- Content -->
        <a href={`/writeups/${featured.slug}`} class="p-10 bg-surface hover:bg-s2 transition-colors flex flex-col gap-5">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="tag-cyan tag">{featured.data.category}</span>
            {featured.data.tags.slice(0,2).map((t: string) => (
              <span class="tag-orange tag">{t}</span>
            ))}
            {featured.data.featured && <span class="tag-green tag">FEATURED</span>}
          </div>

          <h2 class="font-display font-800 text-bright leading-tight tracking-tight hover:text-cyan transition-colors"
              style="font-size: clamp(24px, 3vw, 36px)">
            {featured.data.title}
          </h2>

          <p class="text-sm text-dim leading-relaxed">{featured.data.description}</p>

          <div class="flex items-center gap-4 font-mono text-[11px] text-mute mt-auto pt-4 border-t border-border">
            <div class={`diff diff-${featured.data.difficulty}`}>
              <div class="diff-dot"></div><div class="diff-dot"></div><div class="diff-dot"></div>
            </div>
            <span class="capitalize">{featured.data.difficulty}</span>
            <span>·</span>
            <span>{featured.data.event ?? 'CTF 2024'}</span>
            <span>·</span>
            <span>{featured.data.readTime ?? '8'} min read</span>
          </div>
        </a>

        <!-- Terminal visual -->
        <HeroTerminal client:visible slug={featured.slug} flag={featured.data.flag} />
      </div>
    )}

    <!-- ── CATEGORIES ── -->
    <div class="section-label mb-9">
      <span class="section-label-text">// categories</span>
      <div class="section-label-line"></div>
    </div>

    <CategoryBars client:visible writeups={allWriteups.map(w => ({ category: w.data.category }))} />

    <!-- ── RECENT ── -->
    <div class="section-label mb-6 mt-20">
      <span class="section-label-text">// recent writeups</span>
      <div class="section-label-line"></div>
      <a href="/writeups" class="btn-ghost btn" style="padding: 6px 16px; font-size: 10px;">View All →</a>
    </div>

    <div class="flex flex-col border border-border mb-20">
      {recent.map((w, i) => (
        <a href={`/writeups/${w.slug}`}
           class="grid items-center gap-5 px-6 py-4 border-b border-border last:border-b-0 hover:bg-surface transition-colors group"
           style="grid-template-columns: 52px 1fr auto">
          <span class="font-mono text-[11px] text-mute text-right">
            {String(i+1).padStart(2,'0')}
          </span>
          <div>
            <div class="font-display font-700 text-bright text-[15px] group-hover:text-cyan transition-colors">
              {w.data.title}
            </div>
            <div class="flex items-center gap-2 mt-1">
              <span class={`tag tag-${w.data.catColor ?? 'cyan'}`} style="font-size:9px">{w.data.category}</span>
              <span class="text-[12px] text-mute">{w.data.description?.slice(0,60)}...</span>
            </div>
          </div>
          <div class="hidden md:flex items-center gap-3">
            <div class={`diff diff-${w.data.difficulty}`}>
              <div class="diff-dot"></div><div class="diff-dot"></div><div class="diff-dot"></div>
            </div>
            <span class="font-mono text-[11px] text-mute">
              {new Date(w.data.date).toLocaleDateString('vi-VN', { month: 'short', year: 'numeric' })}
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</Base>
