---
import Base from '../../layouts/Base.astro'
import WriteupFilter from '../../components/WriteupFilter.vue'
import { publishedWriteups } from '../../data/writeups'

export async function getStaticPaths() {
  const tags = new Set<string>()
  publishedWriteups.forEach((w) =>
    [...w.tags, w.category].forEach((t: string) => tags.add(t.toLowerCase()))
  )
  return [...tags].map((tag) => ({ params: { tag }, props: { tag } }))
}

const { tag } = Astro.props

const filtered = publishedWriteups
  .filter(
    (w) =>
      w.tags.some((t: string) => t.toLowerCase() === tag) ||
      w.category.toLowerCase() === tag
  )
  .sort((a, b) => b.date.getTime() - a.date.getTime())

const items = filtered.map((w) => ({
  slug: w.slug,
  title: w.title,
  description: w.description,
  category: w.category,
  catColor: w.catColor ?? 'cyan',
  difficulty: w.difficulty,
  tags: w.tags,
  date: w.date.toISOString(),
  event: w.event,
  readTime: w.readTime,
}))
---

<Base title={`Tag: #${tag}`}>
  <div class="max-w-5xl mx-auto rise-in">
    <div class="mb-8 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <a
        href="/tags"
        class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-widest text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors mb-4 no-underline"
      >
        ← All tags
      </a>
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-2">
        Tag: <span class="text-cyan-600 dark:text-cyan-400">#{tag}</span>
      </h1>
      <p class="text-neutral-600 dark:text-neutral-300 text-sm">
        Found {filtered.length} writeup{filtered.length !== 1 ? 's' : ''} tagged with "{tag}".
      </p>
    </div>

    <WriteupFilter client:load items={items} />
  </div>
</Base>
