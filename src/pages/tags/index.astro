---
import Base from '../../layouts/Base.astro'
import { publishedWriteups } from '../../data/writeups'

const all = publishedWriteups

const tagMap: Record<string, number> = {}
all.forEach((w) => {
  w.tags.forEach((t: string) => {
    tagMap[t] = (tagMap[t] || 0) + 1
  })
})
const tags = Object.entries(tagMap).sort((a, b) => b[1] - a[1])

const catMap: Record<string, number> = {}
all.forEach((w) => {
  catMap[w.category] = (catMap[w.category] || 0) + 1
})
const cats = Object.entries(catMap).sort((a, b) => b[1] - a[1])
---

<Base title="Tags" description="Browse all writeups by category, topic or technology.">
  <div class="max-w-4xl mx-auto rise-in">
    <div class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <div class="inline-flex items-center gap-3 rounded-full border border-neutral-300/70 dark:border-neutral-700 bg-neutral-100/70 dark:bg-neutral-900/40 px-4 py-1 text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-4">
        <span class="h-px w-5 bg-neutral-400 dark:bg-neutral-600"></span>
        <span>Taxonomy</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-2">
        Tags &amp; Categories
      </h1>
      <p class="text-neutral-600 dark:text-neutral-300 text-sm">
        Phân loại bài viết theo chuyên mục bảo mật và từ khóa kỹ thuật.
      </p>
    </div>

    <!-- Categories Grid -->
    <section class="mb-12">
      <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-6">
        <span class="h-px w-5 bg-neutral-400 dark:bg-neutral-600"></span>
        <span>Categories</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        {cats.map(([cat, count]) => (
          <a
            href={`/tags/${encodeURIComponent(cat.toLowerCase())}`}
            class="surface-card rounded-xl p-5 text-center transition-all hover:-translate-y-1 no-underline block"
          >
            <div class="text-2xl mb-2">
              {cat === 'Crypto' ? '🔐' : cat === 'Web' ? '🌐' : cat === 'Pwn' ? '💥' : cat === 'Reverse' ? '🔍' : '🎲'}
            </div>
            <div class="font-semibold text-neutral-900 dark:text-white text-base">
              {cat}
            </div>
            <div class="text-xs font-mono text-neutral-500 dark:text-neutral-400 mt-1">
              {count} {count === 1 ? 'writeup' : 'writeups'}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- All Tags Cloud -->
    <section>
      <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-6">
        <span class="h-px w-5 bg-neutral-400 dark:bg-neutral-600"></span>
        <span>All Tags ({tags.length})</span>
      </div>

      <div class="flex flex-wrap gap-2.5">
        {tags.map(([tag, count]) => (
          <a
            href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}
            class="tag-pill text-xs py-1.5 px-3 flex items-center gap-2"
          >
            <span>{tag}</span>
            <span class="text-[10px] opacity-60">({count})</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
