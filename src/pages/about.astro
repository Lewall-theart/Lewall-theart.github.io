---
import Base from '../layouts/Base.astro'
import { siteConfig } from '../data/site.config'
import SkillBars from '../components/SkillBars.vue'

const lastUpdated = new Date('2026-10-21').toLocaleDateString(
  siteConfig.formatting.dateLocale,
  siteConfig.formatting.dateOptions
)
---

<Base title="About" description={`About ${siteConfig.name} - Information Security, Reverse Engineering and CTF.`}>
  <div class="max-w-4xl mx-auto rise-in">
    <div class="surface-panel rounded-2xl p-6 sm:p-10">
      <!-- Badge -->
      <div class="inline-flex items-center gap-3 rounded-full border border-neutral-300/70 dark:border-neutral-700 bg-neutral-100/70 dark:bg-neutral-900/40 px-4 py-1 text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-6">
        <span class="h-px w-5 bg-neutral-400 dark:bg-neutral-600"></span>
        <span>Bio &amp; Research</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-6">
        About Me — {siteConfig.author.name}
      </h1>

      <div class="prose max-w-none text-neutral-700 dark:text-neutral-300 space-y-4">
        <p class="text-base sm:text-lg leading-relaxed">
          Xin chào! Tôi là <strong>Lewall</strong>, một người đam mê nghiên cứu bảo mật hệ thống, kỹ thuật dịch ngược (Reverse Engineering), và phân tích mã độc.
        </p>

        <p class="leading-relaxed">
          Tôi thường xuyên tham gia các giải đấu <strong>CTF (Capture The Flag)</strong> chuyên về các mảng <em>Reverse Engineering</em>, <em>Cryptography</em>, và <em>Web Security</em>. Blog này được xây dựng nhằm ghi lại các phân tích chuyên sâu về kỹ thuật bóc tách mã máy, bypassing cơ chế bảo vệ, và tài liệu hóa kinh nghiệm thực chiến.
        </p>

        <h2 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-4">
          Lĩnh vực nghiên cứu trọng tâm
        </h2>

        <ul class="space-y-2 list-disc pl-5">
          <li><strong>Windows Internals &amp; Native API:</strong> Nghiên cứu export tables, dynamic syscall stubs, evasion detection, PE/COFF structures.</li>
          <li><strong>Binary Deobfuscation:</strong> Phân tích và deobfuscate mã nguồn .NET, giải mã multi-stage loaders và shellcode payloads.</li>
          <li><strong>Applied Cryptography:</strong> Phân tích thuật toán mã hóa đối xứng/bất đối xứng (AES, RSA, ECC, custom stream ciphers).</li>
          <li><strong>Steganography &amp; Visual Forensics:</strong> Khai thác dữ liệu ẩn trong các kênh hình ảnh và hoạt ảnh số.</li>
        </ul>
      </div>

      <!-- Skills Component -->
      <div class="mt-10 pt-8 border-t border-neutral-200 dark:border-neutral-800">
        <div class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-6">
          // Technical Skills &amp; Proficiencies
        </div>
        <SkillBars client:visible />
      </div>

      <!-- Contact / Social links -->
      <div class="mt-10 pt-8 border-t border-neutral-200 dark:border-neutral-800 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <a
            href={siteConfig.footer.social.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors no-underline"
          >
            GitHub Profile
          </a>
          <a
            href="/rss.xml"
            class="px-4 py-2 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors no-underline"
          >
            RSS Feed
          </a>
        </div>

        <div class="text-xs font-mono text-neutral-400">
          Last updated: {lastUpdated}
        </div>
      </div>
    </div>
  </div>
</Base>
