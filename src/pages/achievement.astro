---
import Base from '../layouts/Base.astro'
import Timeline from '../components/Timeline.vue'
import { timelineEntries } from '../data/timeline'
import { siteConfig } from '../data/site.config'

const lastUpdated = new Date('2026-10-21').toLocaleDateString(
  siteConfig.formatting.dateLocale,
  siteConfig.formatting.dateOptions
)
---

<Base title="Achievements" description="CTF achievements, reverse engineering milestones and security awards.">
  <div class="max-w-4xl mx-auto rise-in">
    <div class="surface-panel rounded-2xl p-6 sm:p-10">
      <div class="inline-flex items-center gap-3 rounded-full border border-neutral-300/70 dark:border-neutral-700 bg-neutral-100/70 dark:bg-neutral-900/40 px-4 py-1 text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-6">
        <span class="h-px w-5 bg-neutral-400 dark:bg-neutral-600"></span>
        <span>Honors &amp; Milestones</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-4">
        CTF &amp; Research Achievements
      </h1>

      <p class="text-neutral-600 dark:text-neutral-300 text-sm sm:text-base leading-relaxed mb-6">
        Tổng hợp các cột mốc trong quá trình tham gia các giải đấu an ninh mạng (CTF), giải mã các thử thách Reverse Engineering &amp; Cryptography, cùng các công trình nghiên cứu hệ thống độc lập.
      </p>

      <!-- Timeline Component -->
      <Timeline entries={timelineEntries} title="Career & Competition Timeline" />

      <div class="mt-12 pt-6 border-t border-neutral-200 dark:border-neutral-800 text-xs font-mono text-neutral-400">
        Last updated: {lastUpdated}
      </div>
    </div>
  </div>
</Base>
