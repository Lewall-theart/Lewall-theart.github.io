---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import FlagReveal from '../../components/FlagReveal.vue'
import TableOfContents from '../../components/TableOfContents.vue'

export async function getStaticPaths() {
  const writeups = await getCollection('writeups', ({data})=>!data.draft)
  return writeups.map(w=>({params:{slug:w.slug},props:{writeup:w}}))
}
const {writeup} = Astro.props
const {Content, headings} = await writeup.render()
const all = await getCollection('writeups',({data})=>!data.draft)
const sorted = all.sort((a,b)=>new Date(b.data.date).getTime()-new Date(a.data.date).getTime())
const idx = sorted.findIndex(w=>w.slug===writeup.slug)
const prev = sorted[idx+1], next = sorted[idx-1]
---
<Base title={writeup.data.title} description={writeup.data.description} showProgress={true}>
  <article>
    <!-- HEADER -->
    <header class="wu-header">
      <div class="wu-header-line"></div>
      <div class="container-narrow">
        <div class="breadcrumb">
          <a href="/">Home</a><span>›</span>
          <a href="/writeups">Writeups</a><span>›</span>
          <span>{writeup.data.title}</span>
        </div>
        <div class="wu-tags">
          <span class={`tag tag-${writeup.data.catColor??'cyan'}`}>{writeup.data.category}</span>
          {writeup.data.tags.map((t:string)=><span class="tag tag-orange">{t}</span>)}
          <div class={`diff diff-${writeup.data.difficulty}`}><div class="diff-dot"></div><div class="diff-dot"></div><div class="diff-dot"></div></div>
          <span class="cap">{writeup.data.difficulty}</span>
        </div>
        <h1 class="wu-title">{writeup.data.title}</h1>
        <p class="wu-desc">{writeup.data.description}</p>
        <div class="wu-meta">
          <span>📅 {new Date(writeup.data.date).toLocaleDateString('vi-VN',{day:'numeric',month:'long',year:'numeric'})}</span>
          {writeup.data.event && <span>🏆 {writeup.data.event}</span>}
          {writeup.data.readTime && <span>⏱ {writeup.data.readTime} min read</span>}
        </div>
      </div>
    </header>

    <!-- BODY WITH TOC -->
    <div class="wu-body">
      <div class="wu-toc">
        <TableOfContents client:load headings={headings.map(h=>({id:h.slug,text:h.text,depth:h.depth}))} />
      </div>
      <div class="wu-content container-narrow">
        <div class="prose">
          <Content />
        </div>
        {writeup.data.flag && (
          <div class="mt-16"><FlagReveal client:visible flag={writeup.data.flag} /></div>
        )}
        <!-- PREV / NEXT -->
        <div class="prevnext">
          {prev ? (
            <a href={`/writeups/${prev.slug}`} class="pn-card pn-prev">
              <div class="pn-label">← PREV</div>
              <div class="pn-title">{prev.data.title}</div>
            </a>
          ) : <div/>}
          {next ? (
            <a href={`/writeups/${next.slug}`} class="pn-card pn-next">
              <div class="pn-label">NEXT →</div>
              <div class="pn-title">{next.data.title}</div>
            </a>
          ) : <div/>}
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
.container-narrow{max-width:780px;margin:0 auto;padding:0 40px;}
.tag{display:inline-flex;align-items:center;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;padding:2px 8px;border:1px solid;}
.tag-cyan{color:#00d4ff;border-color:rgba(0,212,255,.4);background:rgba(0,212,255,.06);}
.tag-orange{color:#ff6b35;border-color:rgba(255,107,53,.4);background:rgba(255,107,53,.06);}
.tag-green{color:#7fff6b;border-color:rgba(127,255,107,.4);background:rgba(127,255,107,.06);}
/* Header */
.wu-header{padding:100px 0 48px;border-bottom:1px solid var(--border);margin-bottom:60px;position:relative;overflow:hidden;}
.wu-header-line{position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(0,212,255,.3),var(--azki-pink),transparent);}
.breadcrumb{display:flex;align-items:center;gap:8px;font-family:'Space Mono',monospace;font-size:11px;color:var(--mute);margin-bottom:24px;}
.breadcrumb a:hover{color:var(--cyan);}
.wu-tags{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:20px;}
.cap{font-family:'Space Mono',monospace;font-size:11px;color:var(--mute);text-transform:capitalize;}
.wu-title{font-family:'Syne',sans-serif;font-weight:800;color:var(--bright);font-size:clamp(30px,5vw,56px);letter-spacing:-2px;line-height:1.05;margin-bottom:20px;}
.wu-desc{font-size:15px;color:var(--dim);line-height:1.75;margin-bottom:24px;max-width:600px;}
.wu-meta{display:flex;align-items:center;gap:20px;font-family:'Space Mono',monospace;font-size:11px;color:var(--mute);flex-wrap:wrap;}
/* Body with TOC sidebar */
.wu-body{display:grid;grid-template-columns:1fr 220px;gap:0;max-width:1100px;margin:0 auto;padding:0 40px 80px;align-items:start;}
.wu-toc{order:2;padding-left:40px;padding-top:0;}
.wu-content{order:1;padding:0;}
/* Remove default container padding since we handle it here */
.wu-content.container-narrow{padding:0;}
@media(max-width:1024px){.wu-body{grid-template-columns:1fr;}.wu-toc{display:none;}.wu-content{padding:0 20px;}}
@media(max-width:600px){.wu-header .container-narrow{padding:0 20px;}}
/* mt-16 */
.mt-16{margin-top:64px;}
/* Prev/Next */
.prevnext{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border:1px solid var(--border);margin-top:64px;}
.pn-card{background:var(--surface);padding:24px;transition:background .2s;}
.pn-card:hover{background:var(--s2);}
.pn-next{text-align:right;}
.pn-label{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:2px;color:var(--mute);margin-bottom:8px;}
.pn-title{font-family:'Syne',sans-serif;font-weight:700;color:var(--bright);font-size:15px;transition:color .2s;}
.pn-card:hover .pn-title{color:var(--cyan);}
</style>
