---
import Writeup from '../../layouts/Writeup.astro'
import { renderMarkdown } from '../../lib/markdown'
import { getPrevNext, getWriteup } from '../../data/writeups'
import raw from '../../writeups/double-trouble.md?raw'

const meta = getWriteup('double-trouble')
if (!meta) throw new Error('Writeup meta not found: double-trouble')
const { code, metadata } = await renderMarkdown(raw)
const { prev, next } = getPrevNext(meta.slug)
---
<Writeup {...meta} headings={metadata.headings} prev={prev} next={next}>
  <Fragment set:html={code} />
</Writeup>

