---
import Base from '../../layouts/Base.astro'
import { publishedWriteups } from '../../data/writeups'
import WriteupFilter from '../../components/WriteupFilter.vue'

const sorted = [...publishedWriteups].sort((a, b) => b.date.getTime() - a.date.getTime())

const items = sorted.map((w) => ({
  slug: w.slug,
  title: w.title,
  description: w.description,
  category: w.category,
  catColor: w.catColor,
  difficulty: w.difficulty,
  tags: w.tags,
  date: w.date.toISOString(),
  event: w.event,
  readTime: w.readTime,
}))
---

<Base title="Writeups" description="All CTF challenges, reverse engineering writeups and cryptographic breakdowns.">
  <div class="max-w-5xl mx-auto rise-in">
    <div class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <div class="inline-flex items-center gap-3 rounded-full border border-neutral-300/70 dark:border-neutral-700 bg-neutral-100/70 dark:bg-neutral-900/40 px-4 py-1 text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-4">
        <span class="h-px w-5 bg-neutral-400 dark:bg-neutral-600"></span>
        <span>Archive // {sorted.length} Articles</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-3">
        All Writeups
      </h1>
      <p class="text-neutral-600 dark:text-neutral-300 text-sm sm:text-base max-w-2xl">
        Danh sách tất cả các bài giải CTF chi tiết từ Easy Warmup đến các thử thách Windows x64 Multi-Stage Reverse Engineering.
      </p>
    </div>

    <!-- Interactive Filter Component -->
    <WriteupFilter client:load items={items} />
  </div>
</Base>
