---
// src/pages/writeups/index.astro
import Base from '../../layouts/Base.astro'
import { publishedWriteups } from '../../data/writeups'
import WriteupFilter from '../../components/WriteupFilter.vue'

const sorted = [...publishedWriteups].sort((a, b) => b.date.getTime() - a.date.getTime())

// Serialize for Vue
const items = sorted.map(w => ({
  slug:        w.slug,
  title:       w.title,
  description: w.description,
  category:    w.category,
  catColor:    w.catColor,
  difficulty:  w.difficulty,
  tags:        w.tags,
  date:        w.date.toISOString(),
  event:       w.event,
  readTime:    w.readTime,
}))
---

<Base title="Writeups">
  <div class="wu-page">
    <div class="container">

      <!-- Header -->
      <header class="border-b border-border pb-16 mb-16">
        <div class="font-mono text-[10px] tracking-[3px] uppercase text-mute mb-4">// all writeups</div>
        <h1 class="font-display font-800 tracking-[-3px] text-bright mb-4"
            style="font-size: clamp(40px, 7vw, 72px)">
          Writeups
        </h1>
        <p class="text-sm text-dim max-w-[480px] leading-relaxed">
          Tất cả các bài giải — từ easy warmup đến insane challenge không có hint.
        </p>
      </header>

      <!-- Vue interactive filter + grid -->
      <WriteupFilter client:load items={items} />

    </div>
  </div>
</Base>

<style>
.wu-page{padding:120px 0 96px;}
.wu-page header{padding-bottom:64px;margin-bottom:64px;}
@media(max-width:1024px){.wu-page{padding:104px 0 80px;}.wu-page header{padding-bottom:56px;margin-bottom:56px;}}
@media(max-width:640px){.wu-page{padding:88px 0 64px;}.wu-page header{padding-bottom:44px;margin-bottom:44px;}}
</style>

