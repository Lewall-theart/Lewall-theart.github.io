---
// src/layouts/Base.astro
import '../styles/global.css'
import SearchModal from '../components/SearchModal.vue'
import Navbar from '../components/Navbar.vue'

interface Props {
  title: string
  description?: string
  showProgress?: boolean
}

const { title, description = 'CTF writeups, crypto breakdowns, and hacking notes.', showProgress = false } = Astro.props
const currentPath = Astro.url.pathname
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} — 0xBlog</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} — 0xBlog`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
</head>
<body>

  <!-- Read progress bar (writeup pages only) -->
  {showProgress && <div id="read-progress"></div>}

  <!-- Vue Islands -->
  <SearchModal client:load />
  <Navbar client:load currentPath={currentPath} />

  <!-- Page content -->
  <main class="relative z-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="mt-30 border-t border-border pt-15 pb-10 relative z-1">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-15 mb-12">
        <div>
          <div class="font-display font-800 text-xl text-bright mb-3 tracking-tight">0xBlog</div>
          <p class="text-sm text-dim leading-relaxed max-w-[280px]">
            Ghi lại hành trình phá mã, khai thác lỗ hổng, và học hỏi qua từng thử thách CTF.
          </p>
        </div>
        <div>
          <div class="font-mono text-[10px] tracking-[2px] uppercase text-mute mb-4">Navigation</div>
          <ul class="flex flex-col gap-2.5">
            {[['/', 'Home'], ['/writeups', 'Writeups'], ['/categories', 'Categories'], ['/about', 'About']].map(([href, label]) => (
              <li>
                <a href={href} class="text-sm text-dim hover:text-cyan transition-colors flex items-center gap-2 group">
                  <span class="text-mute group-hover:text-cyan transition-colors">›</span>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <div class="font-mono text-[10px] tracking-[2px] uppercase text-mute mb-4">Categories</div>
          <ul class="flex flex-col gap-2.5">
            {[['crypto', '🔐 Crypto'], ['web', '🌐 Web'], ['pwn', '💥 Pwn'], ['rev', '🔍 Reverse']].map(([cat, label]) => (
              <li>
                <a href={`/categories/${cat}`} class="text-sm text-dim hover:text-cyan transition-colors flex items-center gap-2 group">
                  <span class="text-mute group-hover:text-cyan transition-colors">›</span>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="flex justify-between items-center pt-6 border-t border-border flex-wrap gap-3">
        <span class="font-mono text-[11px] text-mute">© 2024 0xBlog · Built with Astro + Vue · GitHub Pages</span>
        <div class="flex gap-2">
          <a href="https://github.com" class="w-8 h-8 border border-border flex items-center justify-center text-dim hover:border-cyan hover:text-cyan hover:bg-cyan/6 transition-all" title="GitHub">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  {showProgress && (
    <script>
      const bar = document.getElementById('read-progress')
      if (bar) {
        window.addEventListener('scroll', () => {
          const h = document.documentElement.scrollHeight - window.innerHeight
          bar.style.width = (window.scrollY / h * 100) + '%'
        }, { passive: true })
      }
    </script>
  )}

</body>
</html>
