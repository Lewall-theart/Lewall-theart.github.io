---
import '../styles/global.css'
import { ViewTransitions } from 'astro:transitions'
import Navbar from '../components/Navbar.vue'
import SearchModal from '../components/SearchModal.vue'
import AzkiPlayer from '../components/AzkiPlayer.vue'
import { siteConfig } from '../data/site.config'

interface Props {
  title?: string
  description?: string
  image?: string
  canonical?: string
  type?: 'website' | 'article'
  publishedTime?: Date | string
  modifiedTime?: Date | string
  tags?: string[]
}

const {
  title = siteConfig.home.pageTitle,
  description = siteConfig.metaDescription,
  image,
  canonical,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props

const currentPath = Astro.url.pathname
const pageTitle = `${title} - ${siteConfig.name}`
const canonicalUrl = canonical ?? Astro.url.href
const siteUrl = Astro.site ?? 'https://lewall-theart.github.io'
const ogImage = image ? new URL(image, siteUrl).href : undefined
const currentYear = new Date().getFullYear()

const toIso = (d?: Date | string) => {
  if (!d) return undefined
  const dt = new Date(d)
  return Number.isNaN(dt.getTime()) ? undefined : dt.toISOString()
}
const publishedIso = toIso(publishedTime)
const modifiedIso = toIso(modifiedTime)
---

<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={siteConfig.author.name} />
  <link rel="canonical" href={canonicalUrl} />
  <ViewTransitions />

  <!-- Pre-paint Theme script to prevent flash -->
  <script is:inline>
    (function() {
      try {
        var theme = localStorage.getItem('theme');
        if (theme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={siteConfig.name} />
  <meta property="og:url" content={canonicalUrl} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  {type === 'article' && publishedIso && (
    <meta property="article:published_time" content={publishedIso} />
  )}

  <!-- Twitter Card -->
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  <!-- Favicon & RSS -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS Feed`} href="/rss.xml" />
</head>
<body class="min-h-screen flex flex-col text-neutral-900 dark:text-white transition-colors duration-200">
  <!-- Sticky Tech-Blog Navbar -->
  <Navbar client:load currentPath={currentPath} />

  <!-- Search Modal -->
  <SearchModal client:load />

  <!-- Persistent Music Player -->
  <div data-astro-transition-persist="azki-player">
    <AzkiPlayer client:load />
  </div>

  <!-- Main Content Area -->
  <main class="flex-grow max-w-[1550px] mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    <slot />
  </main>

  <!-- Tech-Blog Footer -->
  <footer class="surface-footer mt-auto">
    <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="col-span-1 md:col-span-3">
          <h3 class="text-xl font-semibold mb-3">{siteConfig.footer.aboutTitle}</h3>
          <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed max-w-2xl">
            {siteConfig.footer.aboutText}
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold mb-3">{siteConfig.footer.connectTitle}</h3>
          <div class="flex space-x-4 text-neutral-700 dark:text-neutral-300">
            <a
              href={siteConfig.footer.social.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-neutral-900 dark:hover:text-white transition-colors"
              aria-label="GitHub"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
            </a>
            <a
              href="/rss.xml"
              class="hover:text-neutral-900 dark:hover:text-white transition-colors"
              aria-label="RSS Feed"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
                <circle cx="5" cy="19" r="1" />
              </svg>
            </a>
          </div>
        </div>
      </div>
      <div class="mt-8 pt-6 border-t border-neutral-200/70 dark:border-neutral-800 text-center text-xs font-mono text-neutral-500 dark:text-neutral-400">
        <div class="flex flex-col items-center gap-1.5">
          <div>
            Theme inspired by <a href="https://github.com/sondt99/Tech-Blog" target="_blank" rel="noopener noreferrer" class="underline hover:text-neutral-700 dark:hover:text-white">sondt</a>
            · Built with Astro &amp; Vue 3
          </div>
          <div>Content © {siteConfig.author.name} {currentYear}</div>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
