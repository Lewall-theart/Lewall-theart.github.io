---
import '../styles/global.css'
import { ViewTransitions } from 'astro:transitions'
import SearchModal from '../components/SearchModal.vue'
import Navbar from '../components/Navbar.vue'
import ParticleBackground from '../components/ParticleBackground.vue'
import AzkiPlayer from '../components/AzkiPlayer.vue'
interface Props {
  title: string
  description?: string
  showProgress?: boolean
  type?: 'website' | 'article'
  image?: string
  canonical?: string
  publishedTime?: Date | string
  modifiedTime?: Date | string
  author?: string
  tags?: string[]
  section?: string
}
const {
  title,
  description = 'CTF writeups, crypto breakdowns, and hacking notes.',
  showProgress = false,
  type = 'website',
  image,
  canonical,
  publishedTime,
  modifiedTime,
  author = 'Lewall',
  tags = [],
  section,
} = Astro.props
const currentPath = Astro.url.pathname
const siteUrl = Astro.site ?? new URL('https://lewall-theart.github.io')
const canonicalUrl = canonical ? new URL(canonical, siteUrl).href : Astro.url.href
const imageUrl = image ? new URL(image, siteUrl).href : undefined
const toIso = (d?: Date | string) => {
  if (!d) return undefined
  const dt = new Date(d)
  return Number.isNaN(dt.getTime()) ? undefined : dt.toISOString()
}
const publishedIso = toIso(publishedTime)
const modifiedIso = toIso(modifiedTime)
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        datePublished: publishedIso,
        dateModified: modifiedIso,
        author: { '@type': 'Person', name: author },
        mainEntityOfPage: canonicalUrl,
        image: imageUrl,
        keywords: tags?.length ? tags.join(', ') : undefined,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: '0xBlog',
        url: siteUrl.href,
        description,
      }
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="description" content={description}/>
  <meta name="author" content={author}/>
  <meta name="robots" content="index,follow"/>
  <link rel="canonical" href={canonicalUrl}/>
  <title>{title} — 0xBlog</title>
  <ViewTransitions />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="alternate" type="application/rss+xml" title="0xBlog RSS" href="/rss.xml"/>
  <meta property="og:title" content={`${title} — 0xBlog`}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content={type}/>
  <meta property="og:site_name" content="0xBlog"/>
  <meta property="og:url" content={canonicalUrl}/>
  <meta property="og:locale" content="vi_VN"/>
  {imageUrl && <meta property="og:image" content={imageUrl}/>}
  <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'}/>
  <meta name="twitter:title" content={`${title} — 0xBlog`}/>
  <meta name="twitter:description" content={description}/>
  {imageUrl && <meta name="twitter:image" content={imageUrl}/>}
  {type === 'article' && publishedIso && (
    <meta property="article:published_time" content={publishedIso}/>
  )}
  {type === 'article' && modifiedIso && (
    <meta property="article:modified_time" content={modifiedIso}/>
  )}
  {type === 'article' && section && <meta property="article:section" content={section}/>}
  {type === 'article' && tags?.map(t => <meta property="article:tag" content={t} />)}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</head>
<body>
  <div id="cursor-dot"></div>
  <div id="cursor-ring"></div>
  {showProgress && <div id="read-progress"></div>}
  <ParticleBackground client:load />
  <SearchModal client:load />
  <Navbar client:load currentPath={currentPath} />
  <div data-astro-transition-persist="azki-player">
    <AzkiPlayer client:load />
  </div>
  <main class="relative z-1">
    <slot />
  </main>
  <footer class="ft">
    <div class="ft-inner">
      <div class="ft-grid">
        <div>
          <div class="ft-brand"><span class="ft-icon">0x</span><span>Blog</span></div>
          <p class="ft-desc">Ghi lại hành trình phá mã, khai thác lỗ hổng, và học hỏi qua từng thử thách CTF.</p>
          <div class="ft-azki">♪ Powered by curiosity &amp; AZKi music</div>
        </div>
        <div>
          <div class="ft-col-title">Navigation</div>
          <ul class="ft-links">
            {[['/', 'Home'],['/writeups','Writeups'],['/tags','Tags'],['/about','About']].map(([h,l]) => (
              <li><a href={h} class="ft-link"><span>›</span>{l}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <div class="ft-col-title">Categories</div>
          <ul class="ft-links">
            {[['crypto','🔐 Crypto'],['web','🌐 Web'],['pwn','💥 Pwn'],['rev','🔍 Rev']].map(([c,l]) => (
              <li><a href={`/tags/${c}`} class="ft-link"><span>›</span>{l}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="ft-bottom">
        <span class="ft-copy">© 2024 0xBlog · Astro + Vue 3 · GitHub Pages</span>
        <div class="ft-socials">
          <a href="/rss.xml" class="ft-soc" title="RSS">📡</a>
          <a href="https://github.com" class="ft-soc" title="GitHub">⌥</a>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
<script>
let dot=null,ring=null
let mx=-100,my=-100,rx=-100,ry=-100
function bindCursorEls(){
  dot=document.getElementById('cursor-dot')
  ring=document.getElementById('cursor-ring')
}
function initCursor(){
  if(window.__cursorInit) return
  window.__cursorInit=true
  document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;if(dot){dot.style.left=mx+'px';dot.style.top=my+'px'}})
  ;(function tick(){rx+=(mx-rx)*.12;ry+=(my-ry)*.12;if(ring){ring.style.left=rx+'px';ring.style.top=ry+'px'}requestAnimationFrame(tick)})()
  document.addEventListener('mouseover',e=>{const t=e.target; if(t&&t.closest&&t.closest('a,button,[role="button"]'))document.body.classList.add('cursor-hover')})
  document.addEventListener('mouseout',e=>{const t=e.target; if(t&&t.closest&&t.closest('a,button,[role="button"]'))document.body.classList.remove('cursor-hover')})
}
let readBar=null
function bindReadProgress(){readBar=document.getElementById('read-progress')}
function onScroll(){
  if(!readBar) return
  const h=document.documentElement.scrollHeight-window.innerHeight
  readBar.style.width=(window.scrollY/h*100)+'%'
}
if(!window.__progressInit){
  window.__progressInit=true
  window.addEventListener('scroll',onScroll,{passive:true})
}
initCursor()
bindCursorEls()
bindReadProgress()
document.addEventListener('astro:page-load',()=>{bindCursorEls();bindReadProgress()})
</script>
<style>
.ft{margin-top:120px;border-top:1px solid var(--border);padding:60px 0 40px;}
.ft-inner{max-width:var(--page-max);margin:0 auto;padding:0 var(--page-pad);}
.ft-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:60px;margin-bottom:48px;}
.ft-brand{display:flex;align-items:center;gap:10px;font-family:'Syne',sans-serif;font-weight:800;font-size:20px;color:var(--bright);margin-bottom:12px;letter-spacing:-.5px;}
.ft-icon{width:32px;height:32px;border:1px solid var(--azki-violet);display:flex;align-items:center;justify-content:center;font-family:'Space Mono',monospace;font-size:12px;color:var(--azki-violet);background:rgba(155,109,255,.06);}
.ft-desc{font-size:13px;color:var(--dim);line-height:1.7;max-width:280px;margin-bottom:12px;}
.ft-azki{font-family:'Space Mono',monospace;font-size:11px;color:var(--azki-pink);}
.ft-col-title{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--mute);margin-bottom:16px;}
.ft-links{list-style:none;display:flex;flex-direction:column;gap:10px;}
.ft-link{font-size:13px;color:var(--dim);transition:color .2s;display:flex;align-items:center;gap:8px;}
.ft-link:hover{color:var(--azki-pink);}
.ft-bottom{display:flex;justify-content:space-between;align-items:center;padding-top:24px;border-top:1px solid var(--border);flex-wrap:wrap;gap:12px;}
.ft-copy{font-family:'Space Mono',monospace;font-size:11px;color:var(--mute);}
.ft-socials{display:flex;gap:8px;}
.ft-soc{width:32px;height:32px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--dim);transition:all .2s;font-size:14px;}
.ft-soc:hover{border-color:var(--azki-pink);color:var(--azki-pink);background:rgba(255,110,180,.06);}
@media(max-width:768px){.ft-inner{padding:0 var(--page-pad-sm);}.ft-grid{grid-template-columns:1fr 1fr;gap:40px;}.ft-grid>:first-child{grid-column:1/-1;}}
@media(max-width:480px){.ft-grid{grid-template-columns:1fr;}}
</style>
