---
import Base from './Base.astro'
import TableOfContents from '../components/TableOfContents.vue'
import FlagReveal from '../components/FlagReveal.vue'
import { siteConfig } from '../data/site.config'

interface Props {
  title: string
  description: string
  date: Date | string
  category: string
  catColor?: string
  difficulty: string
  tags: string[]
  event?: string
  readTime?: number
  flag?: string
  headings?: { slug?: string; id?: string; text: string; depth: number }[]
  prev?: { slug: string; title: string }
  next?: { slug: string; title: string }
}

const {
  title,
  description,
  date,
  category,
  difficulty,
  tags = [],
  event,
  readTime = 6,
  flag,
  headings = [],
  prev,
  next,
} = Astro.props

const formattedDate = (date instanceof Date ? date : new Date(date)).toLocaleDateString(
  'en-US',
  {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }
)

const tocHeadings = headings.map((h) => ({
  id: h.slug ?? h.id ?? '',
  text: h.text,
  depth: h.depth,
}))

const headingCount = headings.length
// Word count approximation
const wordCount = Math.max(350, readTime * 140)
const codeBlockCount = Math.max(1, Math.round(headingCount * 0.4))
const imageCount = 0
const canonicalUrl = Astro.url.href
---

<Base title={title} description={description} type="article" publishedTime={date} tags={tags}>
  <!-- Top Reading Progress Indicator -->
  <div
    id="post-progress-bar"
    class="fixed top-16 left-0 h-0.5 bg-neutral-900 dark:bg-white z-40 transition-[width] duration-75 w-0"
    aria-hidden="true"
  ></div>

  <article class="max-w-[1500px] mx-auto px-2 sm:px-4 lg:px-6 rise-in" style="animation-delay: 60ms;">
    <div class="flex flex-col xl:flex-row items-start justify-between">
      <!-- Main Content Column -->
      <div class="flex-1 max-w-4xl min-w-0 w-full">
        <!-- Back to Writeups Link -->
        <div class="mb-6">
          <a
            href="/writeups"
            class="text-xs font-mono uppercase tracking-widest text-neutral-600 hover:text-neutral-900 inline-block dark:text-neutral-400 dark:hover:text-white no-underline"
          >
            ← {siteConfig.post.backToHomeLabel}
          </a>
        </div>

        <!-- Breadcrumb Navigation -->
        <nav aria-label="Breadcrumb" class="mb-4">
          <ol class="text-xs font-mono uppercase tracking-widest text-neutral-500 flex items-center gap-2 list-none p-0 m-0">
            <li>
              <a href="/" class="hover:text-neutral-900 dark:hover:text-white transition-colors no-underline">
                HOME
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="truncate text-neutral-400">
              {title.toUpperCase()}
            </li>
          </ol>
        </nav>

        <!-- Article H1 Title -->
        <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight mb-4 text-neutral-900 dark:text-white font-mono leading-tight">
          {title}
        </h1>

        <!-- Article Date -->
        <time class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 block mb-4">
          {formattedDate.toUpperCase()}
        </time>

        <!-- Tag List -->
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((t) => (
            <a
              href={`/tags/${encodeURIComponent(t.toLowerCase())}`}
              class="inline-flex items-center rounded-full border border-neutral-300/70 bg-neutral-100/70 dark:border-neutral-700 dark:bg-neutral-900/50 px-3 py-1 text-[10px] font-mono tracking-widest text-neutral-600 dark:text-neutral-400 hover:border-neutral-400 dark:hover:border-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors no-underline"
            >
              {t.toLowerCase()}
            </a>
          ))}
        </div>

        <!-- Share & Copy Link Buttons -->
        <div class="flex items-center gap-4 text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-8">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 hover:text-neutral-900 dark:hover:text-white transition-colors no-underline"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
            SHARE
          </a>

          <button
            id="share-copy-btn"
            type="button"
            class="inline-flex items-center gap-1.5 hover:text-neutral-900 dark:hover:text-white transition-colors cursor-pointer bg-transparent border-0 p-0 font-mono text-xs text-neutral-500 dark:text-neutral-400 uppercase tracking-widest"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
            </svg>
            <span id="share-copy-text">COPY LINK</span>
          </button>
        </div>

        <!-- Article Stats Section (Identical to reference screenshot) -->
        <section class="mb-8">
          <div class="surface-panel rounded-xl p-5 border border-neutral-200 dark:border-neutral-800">
            <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-4 font-semibold">
              ARTICLE STATS
            </h2>
            <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
              <div>
                <dt class="text-[10px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
                  READ TIME
                </dt>
                <dd class="mt-2 text-base sm:text-lg font-semibold text-neutral-900 dark:text-white font-mono">
                  {readTime} min
                </dd>
              </div>

              <div>
                <dt class="text-[10px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
                  WORDS
                </dt>
                <dd class="mt-2 text-base sm:text-lg font-semibold text-neutral-900 dark:text-white font-mono">
                  {wordCount}
                </dd>
              </div>

              <div>
                <dt class="text-[10px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
                  HEADINGS
                </dt>
                <dd class="mt-2 text-base sm:text-lg font-semibold text-neutral-900 dark:text-white font-mono">
                  {headingCount}
                </dd>
              </div>

              <div>
                <dt class="text-[10px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
                  CODE BLOCKS
                </dt>
                <dd class="mt-2 text-base sm:text-lg font-semibold text-neutral-900 dark:text-white font-mono">
                  {codeBlockCount}
                </dd>
              </div>

              <div>
                <dt class="text-[10px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
                  IMAGES
                </dt>
                <dd class="mt-2 text-base sm:text-lg font-semibold text-neutral-900 dark:text-white font-mono">
                  {imageCount}
                </dd>
              </div>
            </dl>
          </div>
        </section>

        <!-- Markdown Body (Contained inside surface-panel) -->
        <div
          id="article-content-box"
          class="prose surface-panel rounded-xl p-6 sm:p-10 border border-neutral-200 dark:border-neutral-800 dark:prose-invert text-neutral-900 dark:text-neutral-100 max-w-none"
        >
          <slot />
        </div>

        <!-- CTF Flag Reveal Component -->
        {flag && (
          <div class="mt-10 pt-8 border-t border-neutral-200 dark:border-neutral-800">
            <FlagReveal client:visible flag={flag} />
          </div>
        )}

        <!-- Prev / Next Navigation Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
          {prev ? (
            <a
              href={`/writeups/${prev.slug}`}
              class="surface-panel rounded-xl p-5 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors no-underline block border border-neutral-200 dark:border-neutral-800"
            >
              <div class="text-[10px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-1">
                ← Previous
              </div>
              <div class="font-semibold text-sm text-neutral-900 dark:text-white line-clamp-1 font-mono">
                {prev.title}
              </div>
            </a>
          ) : <div />}

          {next ? (
            <a
              href={`/writeups/${next.slug}`}
              class="surface-panel rounded-xl p-5 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors no-underline block sm:text-right border border-neutral-200 dark:border-neutral-800"
            >
              <div class="text-[10px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-1">
                Next →
              </div>
              <div class="font-semibold text-sm text-neutral-900 dark:text-white line-clamp-1 font-mono">
                {next.title}
              </div>
            </a>
          ) : <div />}
        </div>
      </div>

      <!-- Table of Contents Sticky Sidebar (Direct flex child with sticky top-24) -->
      <TableOfContents client:load headings={tocHeadings} />
    </div>
  </article>
</Base>

<script>
  function setupArticleScripts() {
    // 1. Reading Progress Bar
    const progressBar = document.getElementById('post-progress-bar')
    const contentBox = document.getElementById('article-content-box')

    function updateProgress() {
      if (!progressBar || !contentBox) return
      const rect = contentBox.getBoundingClientRect()
      const windowHeight = window.innerHeight
      const total = rect.height - windowHeight
      if (total <= 0) {
        progressBar.style.width = '0%'
        return
      }
      const scrolled = Math.max(0, -rect.top)
      const percent = Math.min(100, Math.round((scrolled / total) * 100))
      progressBar.style.width = percent + '%'
    }

    window.addEventListener('scroll', updateProgress, { passive: true })
    updateProgress()

    // 2. Share Copy Link
    const copyBtn = document.getElementById('share-copy-btn')
    const copyText = document.getElementById('share-copy-text')
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href)
          copyText.textContent = 'COPIED!'
          setTimeout(() => {
            copyText.textContent = 'COPY LINK'
          }, 2000)
        } catch (e) {}
      })
    }

    // 3. Inject Mac-style Code Block Copy Buttons
    if (contentBox) {
      const codeBlocks = contentBox.querySelectorAll('pre')
      codeBlocks.forEach((pre) => {
        if (!pre.querySelector('.copy-button')) {
          const btn = document.createElement('button')
          btn.textContent = 'Copy'
          btn.className = 'copy-button'
          btn.setAttribute('type', 'button')
          btn.setAttribute('aria-label', 'Copy code to clipboard')

          const codeEl = pre.querySelector('code')
          const codeText = codeEl ? codeEl.textContent || '' : pre.textContent || ''

          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(codeText)
              btn.textContent = 'Copied!'
              setTimeout(() => {
                btn.textContent = 'Copy'
              }, 2000)
            } catch (err) {}
          })

          pre.appendChild(btn)
        }
      })
    }
  }

  setupArticleScripts()
  document.addEventListener('astro:page-load', setupArticleScripts)
</script>
