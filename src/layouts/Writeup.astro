---
import Base from './Base.astro'
import FlagReveal from '../components/FlagReveal.vue'
import TableOfContents from '../components/TableOfContents.vue'

interface Props {
  title: string
  description: string
  date: Date | string
  category: string
  catColor?: 'cyan' | 'green' | 'orange' | 'red' | 'purple' | 'gold'
  difficulty: 'beginner' | 'easy' | 'medium' | 'hard' | 'insane'
  tags: string[]
  event?: string
  readTime?: number
  flag?: string
  headings?: { slug?: string; id?: string; text: string; depth: number }[]
  prev?: { slug: string; title: string }
  next?: { slug: string; title: string }
}

const {
  title,
  description,
  date,
  category,
  catColor = 'cyan',
  difficulty,
  tags,
  event,
  readTime,
  flag,
  headings = [],
  prev,
  next,
} = Astro.props

const displayDate = (date instanceof Date ? date : new Date(date))
  .toLocaleDateString('vi-VN', { day: 'numeric', month: 'long', year: 'numeric' })
const tocHeadings = headings.map(h => ({ id: h.slug ?? h.id ?? '', text: h.text, depth: h.depth }))
---

<Base
  title={title}
  description={description}
  showProgress={true}
  type="article"
  publishedTime={date}
  modifiedTime={date}
  tags={tags}
  section={category}
>
  <article class="wu">
    <!-- HERO -->
    <header class="wu-hero">
      <div class="wu-hero__line"></div>
      <div class="wu-hero__glow"></div>
      <div class="wu-shell">
        <div class="breadcrumb">
          <a href="/">Home</a><span>›</span>
          <a href="/writeups">Writeups</a><span>›</span>
          <span>{title}</span>
        </div>
        <div class="wu-hero__grid">
          <div class="wu-hero__main">
            <div class="wu-tags">
              <span class={`tag tag-${catColor}`}>{category}</span>
            </div>
            <h1 class="wu-title">{title}</h1>
            <p class="wu-desc">{description}</p>
          </div>
          <aside class="wu-hero__card">
            <div class="meta-head">
              <span class="meta-kicker">// writeup info</span>
              <span class="meta-date">{displayDate}</span>
            </div>
            <div class="meta-list">
              {event && (
                <div class="meta-row">
                  <span class="meta-label">Event</span>
                  <span class="meta-value">{event}</span>
                </div>
              )}
              {readTime && (
                <div class="meta-row">
                  <span class="meta-label">Read</span>
                  <span class="meta-value">{readTime} min</span>
                </div>
              )}
              <div class="meta-row">
                <span class="meta-label">Difficulty</span>
                <span class="meta-value">
                  <span class={`diff diff-${difficulty}`}>
                    <div class="diff-dot"></div><div class="diff-dot"></div><div class="diff-dot"></div>
                  </span>
                  <span class="cap">{difficulty}</span>
                </span>
              </div>
              {tags.length > 0 && (
                <div class="meta-row meta-tags">
                  <span class="meta-label">Tags</span>
                  <div class="meta-tags__list">
                    {tags.map((t:string)=><span class="tag tag-orange">{t}</span>)}
                  </div>
                </div>
              )}
            </div>
          </aside>
        </div>
      </div>
    </header>

    <!-- BODY -->
    <section class="wu-main">
      <div class="wu-main__content">
        <div class="prose">
          <slot />
        </div>
        {flag && (
          <div class="mt-16"><FlagReveal client:visible flag={flag} /></div>
        )}
        <!-- PREV / NEXT -->
        <div class="prevnext">
          {prev ? (
            <a href={`/writeups/${prev.slug}`} class="pn-card pn-prev">
              <div class="pn-label">← PREV</div>
              <div class="pn-title">{prev.title}</div>
            </a>
          ) : <div/>}
          {next ? (
            <a href={`/writeups/${next.slug}`} class="pn-card pn-next">
              <div class="pn-label">NEXT →</div>
              <div class="pn-title">{next.title}</div>
            </a>
          ) : <div/>}
        </div>
      </div>
      <aside class="wu-main__aside">
        <TableOfContents client:load headings={tocHeadings} />
      </aside>
    </section>
  </article>
</Base>

<style>
.wu-shell{max-width:1320px;margin:0 auto;padding:0 var(--page-pad);}
.tag{display:inline-flex;align-items:center;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;padding:2px 8px;border:1px solid;}
.tag-cyan{color:#00d4ff;border-color:rgba(0,212,255,.4);background:rgba(0,212,255,.06);}
.tag-orange{color:#ff6b35;border-color:rgba(255,107,53,.4);background:rgba(255,107,53,.06);}
.tag-green{color:#7fff6b;border-color:rgba(127,255,107,.4);background:rgba(127,255,107,.06);}

/* Hero */
.wu-hero{padding:140px 0 72px;border-bottom:1px solid var(--border);position:relative;overflow:hidden;}
.wu-hero__line{position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(0,212,255,.35),var(--azki-pink),transparent);}
.wu-hero__glow{position:absolute;right:-120px;top:-120px;width:360px;height:360px;background:radial-gradient(circle at center,rgba(0,212,255,.12) 0%,transparent 70%);pointer-events:none;}
.breadcrumb{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-family:'Space Mono',monospace;font-size:11px;color:var(--mute);margin-bottom:22px;}
.breadcrumb a:hover{color:var(--cyan);}
.wu-hero__grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:48px;align-items:end;}
.wu-hero__main{max-width:720px;}
.wu-tags{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:16px;}
.wu-title{font-family:'Syne',sans-serif;font-weight:800;color:var(--bright);font-size:clamp(34px,5.5vw,64px);letter-spacing:-2px;line-height:1.05;margin-bottom:18px;}
.wu-desc{font-size:15px;color:var(--dim);line-height:1.8;margin-bottom:10px;max-width:640px;}

.wu-hero__card{position:relative;border:1px solid var(--border);background:var(--surface);padding:22px;}
.wu-hero__card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--cyan),var(--azki-pink),var(--azki-violet));}
.meta-head{display:flex;align-items:center;justify-content:space-between;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--mute);margin-bottom:16px;}
.meta-date{color:var(--text);letter-spacing:1px;}
.meta-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:8px 0;border-top:1px dashed var(--border);}
.meta-row:first-of-type{border-top:none;}
.meta-label{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--mute);}
.meta-value{font-size:12px;color:var(--text);display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end;text-align:right;}
.meta-tags{align-items:flex-start;}
.meta-tags__list{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end;}
.meta-tags__list .tag{font-size:9px;padding:2px 6px;}
.cap{font-family:'Space Mono',monospace;font-size:11px;color:var(--mute);text-transform:capitalize;}

/* Body */
.wu-main{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:48px;max-width:1320px;margin:0 auto;padding:0 var(--page-pad) 100px;align-items:start;}
.wu-main__content{min-width:0;max-width:920px;}
.wu-main__content .prose{font-size:16px;line-height:1.9;}
.wu-main__content .prose code{font-size:.9em;}

/* mt-16 */
.mt-16{margin-top:64px;}

/* Prev/Next */
.prevnext{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:72px;}
.pn-card{border:1px solid var(--border);background:var(--surface);padding:24px;transition:background .2s,border-color .2s;}
.pn-card:hover{background:var(--s2);border-color:var(--b2);}
.pn-next{text-align:right;}
.pn-label{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:2px;color:var(--mute);margin-bottom:8px;}
.pn-title{font-family:'Syne',sans-serif;font-weight:700;color:var(--bright);font-size:15px;transition:color .2s;}
.pn-card:hover .pn-title{color:var(--cyan);}

@media(max-width:1100px){
  .wu-shell{padding:0 var(--page-pad-sm);}
  .wu-hero{padding:120px 0 64px;}
  .wu-hero__grid{grid-template-columns:1fr;gap:24px;}
  .wu-hero__card{max-width:560px;}
  .wu-main{grid-template-columns:1fr;gap:24px;padding:0 var(--page-pad-sm) 88px;}
  .wu-main__aside{display:none;}
  .wu-main__content{max-width:100%;}
}
@media(max-width:768px){
  .wu-hero{padding:104px 0 56px;}
  .wu-title{font-size:clamp(30px,8vw,48px);}
  .wu-desc{font-size:14px;max-width:100%;}
  .wu-main__content .prose{font-size:15px;line-height:1.85;}
}
@media(max-width:600px){
  .wu-hero{padding:92px 0 48px;}
  .prevnext{grid-template-columns:1fr;}
  .pn-next{text-align:left;}
  .pn-card{padding:20px;}
  .wu-main__content .prose{font-size:14px;line-height:1.8;}
}
</style>
