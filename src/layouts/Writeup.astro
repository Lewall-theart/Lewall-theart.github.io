---
import Base from './Base.astro'
import TableOfContents from '../components/TableOfContents.vue'
import FlagReveal from '../components/FlagReveal.vue'
import { siteConfig } from '../data/site.config'

interface Props {
  title: string
  description: string
  date: Date | string
  category: string
  catColor?: string
  difficulty: string
  tags: string[]
  event?: string
  readTime?: number
  flag?: string
  headings?: { slug?: string; id?: string; text: string; depth: number }[]
  prev?: { slug: string; title: string }
  next?: { slug: string; title: string }
}

const {
  title,
  description,
  date,
  category,
  difficulty,
  tags = [],
  event,
  readTime = 8,
  flag,
  headings = [],
  prev,
  next,
} = Astro.props

const formattedDate = (date instanceof Date ? date : new Date(date)).toLocaleDateString(
  siteConfig.formatting.dateLocale,
  siteConfig.formatting.dateOptions
)

const tocHeadings = headings.map((h) => ({
  id: h.slug ?? h.id ?? '',
  text: h.text,
  depth: h.depth,
}))

const headingCount = headings.length
---

<Base title={title} description={description} type="article" publishedTime={date} tags={tags}>
  <div class="max-w-5xl mx-auto">
    <!-- Back Navigation -->
    <div class="mb-8 rise-in">
      <a
        href="/writeups"
        class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        {siteConfig.post.backToHomeLabel}
      </a>
    </div>

    <!-- Article Header -->
    <header class="mb-10 rise-in" style="animation-delay: 40ms;">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="inline-flex items-center rounded-full border border-neutral-900/80 bg-neutral-900 px-3 py-1 text-[10px] font-mono uppercase tracking-widest text-neutral-100 dark:border-neutral-100/80 dark:bg-neutral-100 dark:text-neutral-900">
          {category}
        </span>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-neutral-300/70 dark:border-neutral-700 text-[10px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
          <div class={`diff diff-${difficulty}`}>
            <div class="diff-dot"></div><div class="diff-dot"></div><div class="diff-dot"></div>
          </div>
          <span>{difficulty}</span>
        </div>
        {tags.map((t) => (
          <a
            href={`/tags/${encodeURIComponent(t.toLowerCase())}`}
            class="tag-pill"
          >
            {t}
          </a>
        ))}
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        {title}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-3xl">
        {description}
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 text-xs font-mono text-neutral-500 dark:text-neutral-400">
        <div class="flex items-center gap-4">
          <time datetime={date.toString()}>{formattedDate}</time>
          {event && <span>· {event}</span>}
          <span>· {readTime} min read</span>
        </div>

        <!-- Share Actions -->
        <div class="flex items-center gap-3">
          <button
            id="copy-btn"
            class="inline-flex items-center gap-1 text-xs font-mono uppercase tracking-widest hover:text-neutral-900 dark:hover:text-white transition-colors"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
            </svg>
            <span id="copy-label">Copy Link</span>
          </button>
        </div>
      </div>

      <!-- Article Stats Banner -->
      <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="surface-card rounded-xl p-3.5 text-center">
          <div class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Read Time</div>
          <div class="text-lg font-semibold mt-1 font-mono">{readTime} min</div>
        </div>
        <div class="surface-card rounded-xl p-3.5 text-center">
          <div class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Category</div>
          <div class="text-lg font-semibold mt-1 font-mono">{category}</div>
        </div>
        <div class="surface-card rounded-xl p-3.5 text-center">
          <div class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Headings</div>
          <div class="text-lg font-semibold mt-1 font-mono">{headingCount}</div>
        </div>
        <div class="surface-card rounded-xl p-3.5 text-center">
          <div class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Difficulty</div>
          <div class="text-lg font-semibold mt-1 font-mono capitalize">{difficulty}</div>
        </div>
      </div>
    </header>

    <!-- Main Content & Table of Contents Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_260px] gap-10 items-start">
      <div class="min-w-0">
        <div class="surface-panel rounded-2xl p-6 sm:p-10">
          <div class="prose max-w-none">
            <slot />
          </div>

          <!-- CTF Flag Reveal Component -->
          {flag && (
            <div class="mt-12 pt-8 border-t border-neutral-200 dark:border-neutral-800">
              <FlagReveal client:visible flag={flag} />
            </div>
          )}
        </div>

        <!-- Prev / Next Navigation -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
          {prev ? (
            <a
              href={`/writeups/${prev.slug}`}
              class="surface-card rounded-xl p-5 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors no-underline block"
            >
              <div class="text-[10px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-1">
                ← Previous
              </div>
              <div class="font-semibold text-sm text-neutral-900 dark:text-white line-clamp-1">
                {prev.title}
              </div>
            </a>
          ) : <div />}

          {next ? (
            <a
              href={`/writeups/${next.slug}`}
              class="surface-card rounded-xl p-5 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors no-underline block sm:text-right"
            >
              <div class="text-[10px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-1">
                Next →
              </div>
              <div class="font-semibold text-sm text-neutral-900 dark:text-white line-clamp-1">
                {next.title}
              </div>
            </a>
          ) : <div />}
        </div>
      </div>

      <!-- Sticky Table of Contents Sidebar -->
      <aside class="hidden xl:block">
        <TableOfContents client:load headings={tocHeadings} />
      </aside>
    </div>
  </div>
</Base>

<script>
  function setupCopy() {
    const btn = document.getElementById('copy-btn')
    const label = document.getElementById('copy-label')
    if (!btn || !label) return

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href)
        label.textContent = 'Copied!'
        setTimeout(() => {
          label.textContent = 'Copy Link'
        }, 2000)
      } catch (e) {}
    })
  }

  setupCopy()
  document.addEventListener('astro:page-load', setupCopy)
</script>
